# Copied to .env by `just glitchtip::up`, which also fills GLITCHTIP_SECRET_KEY.
# `just glitchtip::bootstrap` appends the admin login and the project DSNs.

# Optional compose services: broker (Mosquitto on :1883), bridge (containerized bridge)
COMPOSE_PROFILES=

GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_PORT=8000
GLITCHTIP_SECRET_KEY=

# The broker the robot publishes to (MQTT_BROKER_URI in the firmware), with
# credentials if it has them: mqtt://user:pass@host:port. Host-run bridge
# (`just glitchtip::bridge`); a MQTT_URL set in the shell overrides this line.
MQTT_URL=mqtt://localhost:1883
# Containerized bridge (profile `bridge`); the default is the `broker` profile's Mosquitto:
BRIDGE_MQTT_URL=mqtt://mosquitto:1883
MQTT_TOPIC=robocar/events
