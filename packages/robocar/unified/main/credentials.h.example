/**
 * @file credentials.h.example
 * @brief Template for WiFi and API credentials
 *
 * Copy this file to credentials.h and fill in your actual credentials
 */

#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// WiFi Configuration
#define WIFI_SSID "your_wifi_network_name"
#define WIFI_PASSWORD "your_wifi_password"

// Gemini API Configuration (planner backend — required)
// Get your key from: https://aistudio.google.com/apikey
#define GEMINI_API_KEY "your_gemini_api_key_from_google"

// MQTT broker (optional). Overrides the default in config.h. Use the host and
// port your broker is actually reachable on, e.g. a Docker-mapped port.
// #define MQTT_BROKER_URI "mqtt://192.168.1.10:1883"

// MQTT broker credentials (optional). Without BOTH, robocar/commands accepts
// only read-only status commands (`plan`, `trace`, `servo`, ...) and refuses
// movement and every setting. With both, the full console command set is
// reachable over MQTT — so give the broker `allow_anonymous false` and an ACL
// on robocar/commands, or anyone on the LAN still has the same access.
// Max 32 / 64 characters. `mqtt auth <user> <pass>` on the serial console
// stores a pair in NVS instead, which takes priority over these.
// #define MQTT_USERNAME "robocar"
// #define MQTT_PASSWORD "change-me"

#endif // CREDENTIALS_H
