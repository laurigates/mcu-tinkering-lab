# ESP-IDF Robocar Unified (XIAO ESP32-S3 Sense)
# Run `just --list` to see available recipes

set positional-arguments

import '../../../tools/esp32-idf.just'

project_dir := "packages/robocar/unified"
bin_name := "robocar-unified"
port := env("PORT", _detected_s3)
target := "esp32s3"

default:
    @just --list

##########
# Build (containerized)
##########

# Build firmware (containerized, verifies the .bin was produced)
[group: "build"]
build: (_idf-build-checked bin_name)

# Clean build artifacts (containerized)
[group: "build"]
clean: _idf-clean

# Open configuration menu (containerized)
[group: "build"]
menuconfig: _idf-menuconfig

# Interactive shell in ESP-IDF container
[group: "build"]
shell: _idf-shell

##########
# Flash & Monitor (native — XIAO ESP32-S3 uses native USB-Serial-JTAG)
##########

# Flash firmware to XIAO ESP32-S3 Sense
#
# Kept inline rather than composed from the shared `_s3-flash`, per the
# exotic-layout exception in .claude/rules/containerized-builds.md: this board
# has 8 MB of flash (the shared recipe hardcodes 4MB) and an OTA layout with an
# ota_data segment at 0xd000 that the shared single-app recipe does not write.
# Omitting ota_data leaves stale OTA state behind, which matters here because
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y. Offsets mirror `idf.py build`'s own
# flash_args output — recheck them against it after any partitions.csv change.
[group: "device"]
flash: require-port
    #!/usr/bin/env bash
    set -euo pipefail
    esptool -s --chip esp32s3 -p {{port}} -b "${BAUD:-460800}" \
        --before default-reset --after hard-reset \
        write-flash --flash-mode dio --flash-size 8MB --flash-freq 80m \
        0x0 build/bootloader/bootloader.bin \
        0x8000 build/partition_table/partition-table.bin \
        0xd000 build/ota_data_initial.bin \
        0x10000 build/{{bin_name}}.bin
    echo "Flashed {{bin_name}} OK"

# Reset the board over USB-Serial-JTAG
[group: "device"]
reset: _s3-reset

# Monitor serial output (Ctrl-C to stop) — the XIAO S3 is native
# USB-Serial-JTAG, not a USB-serial adapter, so it needs the S3 monitor
# (which does a CDC reset first), not the generic pyserial one.
[group: "device"]
monitor: _s3-monitor

# Flash and immediately start monitoring
[group: "device"]
flash-monitor: flash monitor

##########
# Info
##########

# Show project information
[group: "info"]
info:
    @echo "Robocar Unified (Single-Board)"
    @echo "  Target:    ESP32-S3"
    @echo "  Port:      {{port}}"
    @echo "  Container: {{container_cmd}}"
    @echo "  Hardware:  XIAO ESP32-S3 Sense + TCA9548A + PCA9685"
