# ESP-IDF Robocar Unified (XIAO ESP32-S3 Sense)
# Run `just --list` to see available recipes

import '../../../tools/esp32-idf.just'

project_dir := "packages/robocar/unified"
bin_name := "robocar-unified"
port := env("PORT", _detected_s3)
target := "esp32s3"

# Typst CLI version the committed build-guide PDF is compiled with. PDF byte
# output changes across compiler releases, so this MUST match TYPST_VERSION in
# .github/workflows/build-guide-check.yml or every local recompile reads as
# drift in CI. Bump both in the same commit.
typst_version := "0.15.0"

default:
    @just --list

##########
# Build (containerized)
##########

# Build firmware (containerized, verifies the .bin was produced)
[group: "build"]
build: (_idf-build-checked bin_name)

# Clean build artifacts (containerized)
[group: "build"]
clean: _idf-clean

# Open configuration menu (containerized)
[group: "build"]
menuconfig: _idf-menuconfig

# Interactive shell in ESP-IDF container
[group: "build"]
shell: _idf-shell

##########
# Flash & Monitor (native — XIAO ESP32-S3 uses native USB-Serial-JTAG)
##########

# Flash firmware to XIAO ESP32-S3 Sense
#
# Kept inline rather than composed from the shared `_s3-flash`, per the
# exotic-layout exception in .claude/rules/containerized-builds.md: this board
# has 8 MB of flash (the shared recipe hardcodes 4MB) and an OTA layout with an
# ota_data segment at 0xd000 that the shared single-app recipe does not write.
# Omitting ota_data leaves stale OTA state behind, which matters here because
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y. Offsets mirror `idf.py build`'s own
# flash_args output — recheck them against it after any partitions.csv change.
[group: "device"]
flash: require-port
    #!/usr/bin/env bash
    set -euo pipefail
    esptool -s --chip esp32s3 -p {{port}} -b "${BAUD:-460800}" \
        --before default-reset --after hard-reset \
        write-flash --flash-mode dio --flash-size 8MB --flash-freq 80m \
        0x0 build/bootloader/bootloader.bin \
        0x8000 build/partition_table/partition-table.bin \
        0xd000 build/ota_data_initial.bin \
        0x10000 build/{{bin_name}}.bin
    echo "Flashed {{bin_name}} OK"

# Reset the board over USB-Serial-JTAG
[group: "device"]
reset: _s3-reset

# Monitor serial output (Ctrl-C to stop) — the XIAO S3 is native
# USB-Serial-JTAG, not a USB-serial adapter, so it needs the S3 monitor
# (which does a CDC reset first), not the generic pyserial one.
[group: "device"]
monitor: _s3-monitor

# Flash and immediately start monitoring
[group: "device"]
flash-monitor: flash monitor

##########
# Diagnostics
##########

# Capture planner frames off the board and decode them to JPEGs + luma stats
#
# The firmware auto-dumps the first FRAME_DUMP_BOOT_FRAMES frames after boot
# (the monitor is read-only, so `snap` cannot be typed through it) and the
# monitor resets the board on attach — so this always captures from boot.
# Ctrl-C once you have enough frames; decoding runs on the way out.
#
# Exists because the decoder lives at the REPO ROOT while this justfile runs in
# the project dir, so the obvious hand-typed `uv run tools/decode-frame-dump.py`
# fails with "No such file or directory".
[group: "device"]
frames log="/tmp/robocar-frames.log" out="/tmp/robocar-frames":
    #!/usr/bin/env bash
    set -uo pipefail
    echo "Capturing to {{log}} — Ctrl-C when you have enough frames..."
    just monitor 2>&1 | tee "{{log}}" || true
    echo
    uv run ../../../tools/decode-frame-dump.py "{{log}}" "{{out}}"

# Decode an existing capture without re-running the monitor
[group: "device"]
frames-decode log="/tmp/robocar-frames.log" out="/tmp/robocar-frames":
    uv run ../../../tools/decode-frame-dump.py "{{log}}" "{{out}}"

##########
# Tests
##########

# Run the host unit tests (native cmake + ctest — no ESP-IDF container).
#
# test/CMakeLists.txt compiles the ESP-IDF-free modules straight from main/
# against the shims in test/include. Nothing here needs the container, and the
# suites are seconds — run this after touching goal_state, ultrasonic,
# reactive_controller, base64, speech_tags, dialogue_style or gemini_parse.
#
# gemini_parse needs cjson: `brew install cjson` (found via pkg-config, else
# Homebrew's prefix).
#
# `.github/workflows/_ci-build-esp32.yml`'s Host unit tests step runs this
# exact recipe in CI on any PR touching this project (issue #482).
[group: "test"]
test:
    #!/usr/bin/env bash
    set -euo pipefail
    cmake -S test -B build-host
    cmake --build build-host
    ctest --test-dir build-host --output-on-failure

##########
# Docs
##########

# Generate Typst definitions from pin_config.h and the planner cadence headers.
# Keep the header list in sync with the drift guard's generator invocation and
# trigger paths in .github/workflows/build-guide-check.yml.
[group: "docs"]
gen-pin-defs:
    python3 ../../../tools/typst/generate-pin-defs.py \
        main/pin_config.h \
        main/planner_task.h \
        main/plan_activity.h \
        docs/auto/pin_defs.typ

# Regenerate every printable Typst document in docs/ — the build guide and the
# bench cards beside it.
#
# Deliberately mirrors .github/workflows/build-guide-check.yml byte for byte:
# the same pinned CLI (via `mise exec`, so an unrelated homebrew typst upgrade
# cannot silently change the output) and the same two determinism flags —
# --creation-timestamp 0 pins the embedded PDF timestamp, --ignore-system-fonts
# embeds only Typst's bundled fonts so glyph fallback does not vary by OS.
# Drop either flag and CI reports the freshly compiled PDF as stale.
#
# The loop matches the guard's own discovery, so adding a card to docs/ needs no
# edit here. docs/auto/ is excluded for the same reason it is there: pin_defs.typ
# is an include, not a document, and has no PDF.
#
# `--others --exclude-standard` is what makes the recipe usable on a card that
# does not exist in the index yet. CI only ever sees tracked files, so the flags
# are a no-op there; locally, without them, a newly written .typ is skipped in
# silence and the first sign of it is the guard failing with "No committed PDF".
[group: "docs"]
build-guide: gen-pin-defs
    #!/usr/bin/env bash
    set -euo pipefail
    cd ../../..
    for typ in $(git ls-files --cached --others --exclude-standard ':(glob)'"{{project_dir}}"'/docs/*.typ'); do
        echo "compiling $typ"
        mise exec typst@{{typst_version}} -- typst compile --creation-timestamp 0 --ignore-system-fonts --root . "$typ" "${typ%.typ}.pdf"
    done

