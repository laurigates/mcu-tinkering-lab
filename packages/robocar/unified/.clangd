# clangd config for this package.
#
# `build/compile_commands.json` is generated by the CONTAINERIZED ESP-IDF
# build (see CLAUDE.md / containerized-builds.md) and therefore records
# container-only paths: `directory: /workspace/...` and ~118 `-I/opt/esp/idf/...`
# include paths. Neither exists on the host, and there is no host ESP-IDF
# toolchain (see #536) — this is a language-server-only workaround, not a
# fix for that mismatch.
#
# Two symptom groups result, and each needs a different remedy:
#
#   1. Five xtensa-gcc-only flags that clang's own driver does not recognise
#      (`-mlongcalls`, `-mdisable-hardware-atomics`, `-fno-shrink-wrap`,
#      `-fstrict-volatile-bitfields`, `-fno-tree-switch-conversion`). These
#      are real GCC flags the containerized xtensa-esp32s3-elf-gcc accepts;
#      clangd parses commands with clang's own driver, which rejects them
#      outright ("unknown argument") before any of the file is even parsed.
#      Stripping them changes nothing about what clangd type-checks — they
#      only affect codegen (long-call veneers, atomics lowering, GCC
#      optimizer passes), never diagnostics.
#
#   2. Every `-I/opt/esp/idf/...` path is unresolvable on the host (no ESP-IDF
#      checkout lives there), so `esp_app_desc.h`, `freertos/*.h`, etc. are
#      genuinely not found — clangd cannot fabricate a header that isn't on
#      disk. That 404 cascades into `esp_err_t`/`QueueHandle_t`/`TaskHandle_t`/
#      `ESP_LOGI`/`pdTRUE` reading as undeclared. Suppress exactly that
#      cascade's diagnostic codes (verified against a live `clangd --check`
#      run against this compile database) rather than disabling the
#      language server for these files — real diagnostics (unused vars,
#      type mismatches, syntax errors, etc.) on lines that don't depend on
#      an unresolved header keep showing up.
CompileFlags:
  Remove:
    - -mlongcalls
    - -mdisable-hardware-atomics
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
  # The header cascade below trips clang's default 19-error limit long
  # before end of file, which stops parsing (and therefore all further
  # diagnostics, suppressed or not) at `fatal_too_many_errors`. Lifting the
  # limit lets clangd keep going so real diagnostics past that point still
  # surface once the cascade itself is suppressed.
  Add:
    - -ferror-limit=0

Diagnostics:
  Suppress:
    - pp_file_not_found
    - unknown_typename
    - undeclared_var_use
    # Same as undeclared_var_use, but the version clang emits when it has a
    # "did you mean X" suggestion (e.g. a local declared with an unresolved
    # struct type, then referenced later in the same function).
    - undeclared_var_use_suggest
    - -Wimplicit-function-declaration
    # Downstream of an implicit-int function whose real return type lives in
    # a header that isn't found (e.g. `esp_app_get_description()->version`):
    # clang falls back to `int` for the undeclared return type, then flags
    # `->` on it. Same cascade, one more diagnostic code.
    - typecheck_member_reference_arrow
  # Include Cleaner can't resolve any -I path on the host either, so its
  # "this include looks unused" analysis is working from the same missing
  # headers and produces the same class of false positive.
  UnusedIncludes: None

# Known residual, not covered by the list above: a file that casts an
# ESP-IDF event-struct typedef straight to a pointer (e.g.
# `(wifi_event_sta_disconnected_t *)event_data` in wifi_manager.c) still
# shows a handful of `expected_expression`/`expected` parse errors, because
# the unresolved typedef makes the cast unparsable. Those two diagnostic
# codes are not suppressed here: they cover essentially every "expected X"
# syntax error clang has, so suppressing them would hide real syntax
# mistakes throughout the file, not just this cascade. Verified clean with
# `clangd --check` on this package's main.c, ota_manager.c, mqtt_logger.c,
# and voice_persona.c; wifi_manager.c keeps its five cascade-derived
# parse-error lines pending a narrower fix (see issue #536 follow-ups).
