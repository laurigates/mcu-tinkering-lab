# Ceiling Fan IR — ESPHome project (ESP_IR_TR: ESP-01M / ESP8285)
# Run `just --list` to see available recipes

import '../../../tools/esphome.just'

device_name := "ceiling-fan-ir"
config_file := device_name + ".yaml"
secrets_file := "secrets.yaml"
secrets_example := "secrets.yaml.example"
# /dev/cu.* names of the USB-serial adapter upload and logs auto-detect
# (grep -E, first match wins)
usb_port_pattern := "usbserial|SLAB|wchusbserial|usbmodem"

default:
    @just --list

# Create secrets.yaml from template
[group: "setup"]
config: _esphome-config

# Initial setup: install ESPHome and create config
[group: "setup"]
init: install config
    @echo ""
    @echo "Initialization complete!"
    @echo "Next steps:"
    @echo "  1. Edit {{secrets_file}} with your WiFi credentials and API key"
    @echo "  2. Run 'just pins' for the USB-serial wiring, then 'just upload'"
    @echo "  3. Run 'just logs' and press buttons on the fan's remote"

# Compile and upload via USB-serial adapter (auto-detects port)
[group: "flash"]
upload: _flash-mode-hint (_esphome-upload usb_port_pattern)

[private]
_flash-mode-hint:
    @echo "Flashing through the USB-serial adapter — the IO0-GND jumper must be fitted at power-up"

# First USB flash (run before wireless updates are possible)
[group: "flash"]
first-flash: config upload
    @echo ""
    @echo "First flash complete! Remove the IO0-GND jumper and power-cycle."
    @echo "Future updates: just wireless"

# View device logs via USB-serial (auto-detects, falls back to OTA)
[group: "monitor"]
logs: (_esphome-logs usb_port_pattern)

# View device logs via WiFi OTA
[group: "monitor"]
logs-wireless:
    esphome logs {{config_file}} --device {{device_name}}.local

# Alias for logs
[group: "monitor"]
monitor: logs

# Display pin assignment and flashing reference
[group: "info"]
pins:
    @echo "Header (6 pins, pin 1 at the board corner):"
    @echo "  1 GND  ← adapter GND"
    @echo "  2 5V   ← adapter 5V (feeds the on-board AMS1117-3.3)"
    @echo "  3 RX   ← adapter TX (3.3 V logic)"
    @echo "  4 TX   → adapter RX"
    @echo "  5 IO0  ┐ jumper fitted = flash mode;"
    @echo "  6 GND  ┘ remove it for normal boot"
    @echo ""
    @echo "On-board: IR LED GPIO4, IR receiver GPIO14 (inverted)"
    @echo "Board: ESP_IR_TR (ESP-01M, ESP8285) — docs/reference/boards/esp-ir-tr.md"

# Quick dev cycle: upload then watch logs
[group: "device"]
develop: upload logs
