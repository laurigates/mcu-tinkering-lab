# ESP32-S3 target
CONFIG_IDF_TARGET="esp32s3"

# USB-Serial-JTAG for monitoring
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# WiFi — required by ESP-NOW
CONFIG_ESP_WIFI_ENABLED=y

# ESP-NOW is part of esp_wifi and has no Kconfig enable switch in ESP-IDF v5.4

# Disable WiFi AMPDU (known S3 AP visibility workaround)
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

# Disable WiFi NVS storage (we use NVS manually for tag registry)
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Reduce WiFi buffers
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8

# Disable 11kv
CONFIG_ESP_WIFI_11KV_SUPPORT=n

# Disable Bluetooth entirely
CONFIG_BT_ENABLED=n

# No PSRAM
CONFIG_SPIRAM=n

# OTA table shared by the boxes that start the thinkpack-ota receiver:
# otadata plus ota_0/ota_1 on a 4 MB part (issue #1076).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../components/thinkpack-ota/partitions.csv"

# Logging level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Larger main task stack for WiFi + ESP-NOW + RC522 init
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Flash size (ESP32-S3 SuperMini, 4 MB); the OTA table needs all of it
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
