# ESP32-S3 target
CONFIG_IDF_TARGET="esp32s3"

# USB-Serial-JTAG for monitoring
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# WiFi — required by ESP-NOW
CONFIG_ESP_WIFI_ENABLED=y

# ESP-NOW is part of esp_wifi and has no Kconfig enable switch in ESP-IDF v5.4

# AMPDU off: inherited from a SoftAP-on-S3 workaround, but this box runs no
# SoftAP (STA + ESP-NOW only). Kept as is; AMPDU on is unmeasured with STA
# and ESP-NOW sharing one radio (#1081).
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n

# WiFi NVS off: kept as is, also unmeasured. STA credentials live in brainbox's
# own NVS namespace (credentials_loader.c), not the driver's.
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Reduce WiFi buffers
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8

# Disable 11kv
CONFIG_ESP_WIFI_11KV_SUPPORT=n

# Disable Bluetooth entirely
CONFIG_BT_ENABLED=n

# Built-in single-app table with the 1.5 MB factory partition (no custom
# partitions.csv). The app outgrew the 1 MB SINGLE_APP default once it
# linked mdns, TLS and the LLM backends (issue #671).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Logging level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Enable HTTP client for LLM API calls
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# PSRAM on Brainbox (WROOM N8R8) for HTTP response buffering (PRD FR-T03)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Larger main task stack for WiFi + HTTP + mesh init
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240

# mDNS (Ollama discovery) comes from the espressif/mdns managed component in
# main/idf_component.yml; it has no enable switch here.
