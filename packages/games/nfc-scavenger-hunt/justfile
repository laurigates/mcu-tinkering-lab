# NFC Scavenger Hunt — voice-guided NFC treasure hunt (ESP32-S3)
# Run `just` or `just --list` to see available recipes

import '../../../tools/esp32-idf.just'

project_dir := "packages/games/nfc-scavenger-hunt"
bin_name := "nfc-scavenger-hunt"
port := env("PORT", _detected_s3)
target := "esp32s3"

default:
    @just --list

# Build firmware in Docker container (validated: filtered output + .bin check)
[group: "build"]
build: (_idf-build-checked bin_name)

# Clean build artifacts (containerized)
[group: "build"]
clean: _idf-clean

# Open configuration menu (containerized)
[group: "build"]
menuconfig: _idf-menuconfig

# Interactive shell in ESP-IDF container
[group: "build"]
shell: _idf-shell

# Flash bootloader, partition table and app (single factory app, 4 MB)
[group: "device"]
flash: (_s3-flash bin_name)

# Reset board via USB-Serial-JTAG CDC control signals
[group: "device"]
reset: _s3-reset

# Serial monitor with reset (Ctrl-C to stop)
[group: "device"]
monitor: _s3-monitor

# Flash and monitor
[group: "device"]
flash-monitor: flash monitor

# Show project information
[group: "info"]
info:
    @echo "Project: nfc-scavenger-hunt"
    @echo "  Target: ESP32-S3"
    @echo "  Binary: build/{{bin_name}}.bin"
    @echo "  Port:   {{if port == "" { "(not detected — board not connected?)" } else { port } }}"
    @echo "  mDNS:   nfc-scavenger-hunt.local"
