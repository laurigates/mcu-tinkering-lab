# ESP32-CAM (AI-Thinker). The camera pins are the CAM_PIN_* defines in
# main/main.c: espressif/esp32-camera has no Kconfig symbols for pins or board.

# Brownout detector configuration - Level 5 (2.70V) for better stability
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_5=y
CONFIG_ESP_BROWNOUT_DET_LVL=5

# PSRAM is required for camera applications
CONFIG_ESP32_SPIRAM_SUPPORT=y

# Wi-Fi configuration (canonical block — see .claude/skills/wifi-sta-setup)
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMSDU_TX_ENABLED=y
CONFIG_ESP_WIFI_NVS_ENABLED=y

# Brownout-justified TX power cap: AI-Thinker ESP32-CAM has documented
# brownout-during-WiFi-association issues; brownout detector is enabled above.
# See README.md "Power Considerations" and the 1-second power stabilization
# delay in app_main(). Do not remove without re-verifying brownout behaviour.
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=15
CONFIG_ESP_PHY_MAX_TX_POWER=15

# HTTP server configuration
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# LWIP configuration for the web server
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_REUSE_RXTOALL=y

# mDNS (esp32-cam.local) comes from the espressif/mdns managed component in
# main/idf_component.yml; it has no enable switch here.

# Flash memory
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# "Single factory app (large)": factory grows 1M -> 1500K at the same 0x10000
# offset, nvs/phy_init unchanged. The implicit 1 MB SINGLE_APP default had
# 0xCAB0 bytes (5%) left on 2026-09-19 (#582).
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
