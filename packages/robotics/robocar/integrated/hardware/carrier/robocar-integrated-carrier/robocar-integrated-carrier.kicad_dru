(version 1)

# Every pad of a poured net (GND on the main board, HEAD_GND, HEAD2_GND and
# HEAD3_GND on the three head boards) is also routed with a track
# (route_board.py checks this before pouring), so a thermal relief is a second
# connection, not the only one. Between fine-pitch chip pins the routed tracks
# can leave room for a single spoke.
(rule "Pour thermals may resolve to one spoke"
	(condition "A.Type == 'Pad' && (A.NetName == 'GND' || A.NetName == 'HEAD_GND' || A.NetName == 'HEAD2_GND' || A.NetName == 'HEAD3_GND')")
	(constraint min_resolved_spokes 1))

# JLCPCB's CAM deletes silkscreen within 0.15 mm of a pad's mask opening without
# asking (character-design-specifications, docs/reference/jlc-blog/). Checked in
# KiCad 10.0.6: this rule moves silk_over_copper's limit 0.15 mm out from the
# opening. A (layer ...) clause disables it, and min_silk_clearance only spaces
# silkscreen from silkscreen.
(rule "silkscreen 0.15 mm clear of pads"
	(condition "B.Type == 'Pad'")
	(constraint silk_clearance (min 0.15mm)))
