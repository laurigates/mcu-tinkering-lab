(version 1)

# Every pad of a poured net (HEAD_GND, HEAD2_GND and HEAD3_GND, one per head
# board) is also routed with a track (route_board.py checks this before
# pouring), so a thermal relief is a second connection, not the only one.
# Between 2.54 mm-pitch header pins the routed tracks can leave room for a
# single spoke.
# KiCad 10's starved-thermal check reads the .kicad_pro's min_resolved_spokes,
# not this rule, so that is 1 as well (#1302; test_project_settings.py).
(rule "Pour thermals may resolve to one spoke"
	(condition "A.Type == 'Pad' && (A.NetName == 'HEAD_GND' || A.NetName == 'HEAD2_GND' || A.NetName == 'HEAD3_GND')")
	(constraint min_resolved_spokes 1))

# JLCPCB's CAM deletes silkscreen within 0.15 mm of a pad's mask opening without
# asking (character-design-specifications, docs/reference/jlc-blog/). Checked in
# KiCad 10.0.6: this rule moves silk_over_copper's limit 0.15 mm out from the
# opening. A (layer ...) clause disables it, and min_silk_clearance only spaces
# silkscreen from silkscreen.
(rule "silkscreen 0.15 mm clear of pads"
	(condition "B.Type == 'Pad'")
	(constraint silk_clearance (min 0.15mm)))
