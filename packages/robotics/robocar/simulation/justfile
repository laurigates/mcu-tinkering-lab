# Robocar simulation: the plant the behaviour twin steps (ADR-036) and the
# legacy demo of the removed dual-ESP32 car.
# Run `just --list` to see available recipes

default:
    @just --list

##########
# setup
##########

# Verify the core dependencies and the plant are importable
[group: "setup"]
check-deps:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run python -c "import numpy, pymunk, yaml, robocar_sim.plant" \
        && echo "Core dependencies available" \
        || { echo "Missing dependencies — run 'uv sync --extra dev'"; exit 1; }

# Validate robot config YAML and check deps
[group: "setup"]
setup: check-deps check-config
    @echo ""
    @echo "Setup complete! Try:"
    @echo "  just plant-demo   # Step the plant through a scripted drive"
    @echo "  just test         # Run tests"
    @echo "  just info         # Show system info"

##########
# plant
##########

# Run the plant's JSONL stepper on stdin/stdout (ADR-036 section 3: the command the twin harness starts)
[group: "plant"]
plant:
    uv run --locked --quiet python -m robocar_sim.plant

# Step the plant through scripted wheel commands: pose trace to tmp/, and a plot where the viz extra is installed
[group: "plant"]
plant-demo *args:
    mkdir -p tmp
    uv run --locked python -m robocar_sim.plant_demo --out tmp/plant_demo_trace.jsonl --plot tmp/plant_demo.png {{args}}

##########
# run (legacy demo; needs the viz extra)
##########

# Run the legacy demo in headless mode
[group: "run"]
run:
    PYTHONUNBUFFERED=1 uv run --extra viz python -m robocar_sim.main --headless

# Run the legacy demo with a GUI window
[group: "run"]
run-visual:
    PYTHONUNBUFFERED=1 uv run --extra viz python -m robocar_sim.main --visual

# Run the legacy demo with the browser interface (http://localhost:52000)
[group: "run"]
run-browser:
    @echo "Access visualization at: http://localhost:52000"
    PYTHONUNBUFFERED=1 uv run --extra viz python -m robocar_sim.main --browser

# Run the legacy demo headless (explicit alias for run)
[group: "run"]
run-headless:
    PYTHONUNBUFFERED=1 uv run --extra viz python -m robocar_sim.main --headless

##########
# test
##########

# The test, lint and type-check recipes name the dev extra: the twin's plant
# recipes build this environment without it, and `uv run` would then fall back
# to whatever pytest or ruff is on PATH.

# Run all tests
[group: "test"]
test:
    uv run --extra dev pytest tests/ -v

# Test robot model only
[group: "test"]
test-robot:
    uv run --extra dev pytest tests/test_robot_model.py::TestDifferentialDriveRobot -v

# Test motor dynamics
[group: "test"]
test-motor:
    uv run --extra dev pytest tests/test_robot_model.py::TestDCMotor -v

# Test simulation accuracy
[group: "test"]
test-accuracy:
    uv run --extra dev pytest tests/test_robot_model.py::TestSimulationAccuracy -v

# Test the plant, its arena schema and its stepper
[group: "test"]
test-plant:
    uv run --extra dev pytest tests/test_plant.py tests/test_arena.py tests/test_plant_stepper.py -v

# Test visualization availability (viz extra)
[group: "test"]
test-viz:
    uv run --extra viz python -c "from robocar_sim.genesis_visualizer import HAS_GENESIS; print(f'Genesis available: {HAS_GENESIS}')"

# Quick smoke tests for core components
[group: "test"]
test-quick:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run python -c "from robocar_sim.plant import Plant; print('Plant OK')"
    uv run python -c "from robocar_sim.robot_model import DifferentialDriveRobot; print('Robot model OK')"
    uv run python -c "import numpy, pymunk, yaml; print('Core dependencies OK')"

##########
# dev
##########

# Run linter (ruff)
[group: "dev"]
lint:
    uv run --extra dev ruff check src/ tests/

# Format code with ruff
[group: "dev"]
format:
    uv run --extra dev ruff format src/ tests/

# Run type checking with ty (astral)
[group: "dev"]
type-check:
    uv run --extra dev ty check src/

# Validate the legacy robot config YAML and the plant's robot description
[group: "dev"]
check-config:
    uv run python -c "import yaml; yaml.safe_load(open('config/robot_config.yaml')); print('Legacy configuration valid')"
    uv run python -c "from robocar_sim.plant import Plant; Plant({'floor': [[0, 0], [100, 0], [100, 100]]}, 0, config=None); print('plant.yaml valid')"

# Run performance benchmarks
[group: "dev"]
benchmark:
    uv run --extra dev pytest tests/test_robot_model.py::TestSimulationAccuracy::test_simulation_stability -v -s

# Clean Python cache and temp files
[group: "dev"]
clean:
    #!/usr/bin/env bash
    set -euo pipefail
    find . -type f -name "*.pyc" -delete
    find . -type d -name "__pycache__" -delete
    find . -type d -name "*.egg-info" -exec rm -rf {} +
    find . -type f -name ".coverage" -delete
    find . -type d -name ".pytest_cache" -exec rm -rf {} +
    find . -type d -name ".mypy_cache" -exec rm -rf {} +
    find . -type d -name ".ty_cache" -exec rm -rf {} +

##########
# info
##########

# Show simulation information
[group: "info"]
info:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Robocar simulation"
    echo "Python version: $(uv run python --version)"
    echo "Working directory: $(pwd)"
    echo "Plant robot description: src/robocar_sim/plant.yaml"
    echo "Legacy demo configuration: config/robot_config.yaml"

# Component status check
[group: "info"]
status:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Simulation Status"
    printf "Plant:                "
    uv run python -c "from robocar_sim.plant import Plant; print('OK')" 2>/dev/null || echo "Error"
    printf "Robot model (legacy): "
    uv run python -c "from robocar_sim.robot_model import DifferentialDriveRobot; print('OK')" 2>/dev/null || echo "Error"
    printf "Genesis visualizer:   "
    uv run python -c "from robocar_sim.genesis_visualizer import HAS_GENESIS; print('Available' if HAS_GENESIS else 'Not available (matplotlib fallback active)')" 2>/dev/null || echo "viz extra not installed"
    printf "Configuration:        "
    uv run python -c "import yaml; yaml.safe_load(open('config/robot_config.yaml')); print('Valid')" 2>/dev/null || echo "Invalid"
