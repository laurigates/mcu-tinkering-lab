# Balancebot — XIAO RP2350 self-balancing robot
# Run `just --list` to see available recipes

import '../../../tools/pico.just'

project_dir := "packages/robotics/balancebot"
board := "seeed_xiao_rp2350"
port := env("PORT", _detected_pico)

# Typst CLI version the committed build-guide PDF is compiled with. PDF byte
# output changes across compiler releases, so this MUST match TYPST_VERSION in
# .github/workflows/build-guide-check.yml or every local recompile reads as
# drift in CI. Bump both in the same commit.
typst_version := "0.15.0"

default:
    @just --list

##########
# Build (containerized)
##########

# Build firmware (containerized cmake + ninja, produces build/balancebot.uf2)
[group: "build"]
build: _pico-build

# Remove build artifacts
[group: "build"]
clean: _pico-clean

# Interactive shell in the Pico SDK container
[group: "build"]
shell: _pico-shell

# Build and run host-side unit tests (PID, filter, CRC — no hardware)
[group: "build"]
test:
    #!/usr/bin/env bash
    set -euo pipefail
    cmake -S tests/host -B build-host -G Ninja
    cmake --build build-host
    ctest --test-dir build-host --output-on-failure

##########
# Flash & Monitor (native — USB CDC / BOOTSEL)
##########

# Flash via picotool (reboots a running board into BOOTSEL automatically)
[group: "device"]
flash:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v picotool >/dev/null 2>&1 || { echo "Error: picotool not found — brew install picotool"; exit 1; }
    picotool load -f build/balancebot.uf2
    picotool reboot
    echo "Flashed OK"

# Flash without picotool: drag-and-drop instructions
[group: "device"]
flash-uf2:
    @echo "1. Hold BOOT on the XIAO RP2350 and plug in USB (or hold BOOT and tap RESET)"
    @echo "2. A drive named RP2350 appears"
    @echo "3. Copy build/balancebot.uf2 onto it — the board reboots into the firmware"

# Monitor USB CDC serial output (Ctrl-C to stop)
[group: "device"]
monitor: _serial-monitor

# Flash and immediately start monitoring
[group: "device"]
flash-monitor: flash monitor

# Full dev cycle
[group: "device"]
develop: build flash monitor

##########
# Docs
##########

# Generate Typst definitions from the hardware join (tools/hardware/, ADR-021).
# The header it reads, src/pin_config.h, is named once in hardware.toml's
# [source] and must also be on the trigger paths in
# .github/workflows/build-guide-check.yml.
[group: "docs"]
gen-pin-defs:
    python3 ../../../tools/typst/generate-pin-defs.py .

# The drift guard regenerates these images too, so a board-reference change
# that skips this recipe fails CI rather than printing a stale header order.
#
# Draw the build guide's board pinout images (docs/auto/pinouts/*.svg) from the board references
[group: "docs"]
gen-pinouts:
    cd ../../.. && PYTHONPATH=tools python3 -m hardware.pinout {{project_dir}}

# Regenerate every printable Typst document in docs/.
#
# Mirrors .github/workflows/build-guide-check.yml byte for byte: the same pinned
# CLI (via `mise exec`) and the same two determinism flags. Drop either flag
# and CI reports the freshly compiled PDF as stale. `--others
# --exclude-standard` picks up a .typ not in the index yet; docs/auto/ is
# excluded because pin_defs.typ is an include with no PDF of its own.
[group: "docs"]
build-guide: gen-pin-defs gen-pinouts
    #!/usr/bin/env bash
    set -euo pipefail
    cd ../../..
    for typ in $(git ls-files --cached --others --exclude-standard ':(glob)'"{{project_dir}}"'/docs/*.typ'); do
        echo "compiling $typ"
        mise exec typst@{{typst_version}} -- typst compile --creation-timestamp 0 --ignore-system-fonts --root . "$typ" "${typ%.typ}.pdf"
    done

##########
# Carrier PCB (hardware/carrier/, KiCad 10)
##########

carrier_dir := "hardware/carrier"
carrier_pcb := carrier_dir / "balancebot-carrier/balancebot-carrier.kicad_pcb"
carrier_sch := carrier_dir / "balancebot-carrier/balancebot-carrier.kicad_sch"
carrier_out := carrier_dir / "balancebot-carrier/output"
kicad_python := env("KICAD_PYTHON", "/Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/bin/python3")

# Regenerate the socket-mount XIAO footprint and symbol from Seeed's DIP ones
[group: "carrier"]
carrier-lib:
    cd ../../.. && PYTHONPATH=tools python3 -m kicad.derive_xiao

# Rewrites the .kicad_pcb from scratch. Freerouting does not route the same
# way twice, so commit the board you checked, not a re-run of it.
#
# Place, autoroute (Freerouting) and pour the carrier board from its schematic
[group: "carrier"]
carrier-board:
    {{kicad_python}} {{carrier_dir}}/scripts/build_board.py
    {{kicad_python}} {{carrier_dir}}/scripts/route_board.py

# ERC, DRC with schematic parity, and the pin_config.h cross-check
[group: "carrier"]
carrier-check:
    mkdir -p {{carrier_out}}
    kicad-cli sch erc --severity-all --exit-code-violations -o {{carrier_out}}/erc.rpt {{carrier_sch}}
    kicad-cli pcb drc --severity-all --schematic-parity --exit-code-violations -o {{carrier_out}}/drc.rpt {{carrier_pcb}}
    python3 {{carrier_dir}}/scripts/check_pins.py

# Gerbers and drill files for JLCPCB, zipped, plus the BOM and CPL for its
# assembly service (SMD passives only; skip them to hand-solder)
[group: "carrier"]
carrier-fab: carrier-check
    #!/usr/bin/env bash
    set -euo pipefail
    fab={{carrier_out}}/fab
    rm -rf "${fab:?}" && mkdir -p "$fab"
    kicad-cli pcb export gerbers --check-zones \
        --layers F.Cu,B.Cu,F.Paste,B.Paste,F.Silkscreen,B.Silkscreen,F.Mask,B.Mask,Edge.Cuts \
        -o "$fab" {{carrier_pcb}}
    kicad-cli pcb export drill --excellon-separate-th --generate-map --map-format gerberx2 -o "$fab/" {{carrier_pcb}}
    (cd "$fab" && zip -q -r ../balancebot-carrier-fab.zip .)
    echo "wrote {{carrier_out}}/balancebot-carrier-fab.zip"
    asm={{carrier_out}}/assembly
    rm -rf "${asm:?}" && mkdir -p "$asm"
    kicad-cli sch export bom --fields 'Value,Reference,Footprint,LCSC' \
        --labels 'Comment,Designator,Footprint,LCSC' --group-by 'Value,Footprint,LCSC' \
        --ref-range-delimiter '' --exclude-dnp -o "$asm/bom.csv" {{carrier_sch}}
    kicad-cli pcb export pos --format csv --units mm --side front --smd-only \
        -o "$asm/pos.csv" {{carrier_pcb}}
    python3 {{carrier_dir}}/scripts/jlc_assembly.py "$asm/bom.csv" "$asm/pos.csv" "$asm"

##########
# Perfboard prototype (hardware/perfboard/)
##########

# Lay the carrier circuit out on a 50 x 70 mm perfboard: drawing + wire list
[group: "carrier"]
perfboard:
    python3 hardware/perfboard/perfboard.py

# Fail if the perfboard drawing or wire list is stale, or the layout breaks
[group: "carrier"]
perfboard-check:
    python3 hardware/perfboard/perfboard.py --check

##########
# Info
##########

# Show project information
[group: "info"]
info:
    @echo "Balancebot — self-balancing robot"
    @echo "  Board:     Seeed XIAO RP2350 (PICO_BOARD={{board}})"
    @echo "  IMU:       MPU6050 on I2C1 (SDA=GPIO6/D4, SCL=GPIO7/D5, INT=GPIO5/D3)"
    @echo "  Steppers:  2x DRV8825 + NEMA17, 1/8 microstep"
    @echo "             STEP L/R=GPIO2/3 (PIO0), DIR L/R=GPIO4/0, nENABLE=GPIO1"
    @echo "  Tuning:    USB CDC CLI — 'just balancebot::monitor' then 'help'"
    @echo "  Port:      {{port}}"
