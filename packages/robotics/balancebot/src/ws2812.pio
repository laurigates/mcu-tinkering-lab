; WS2812-type LED driver: one bit per 10 PIO cycles at 800 kHz.
; Adapted from the Raspberry Pi pico-examples ws2812 program
; (Copyright (c) 2020 Raspberry Pi (Trading) Ltd., BSD-3-Clause).
; Runs on PIO1: PIO0 drives the steppers (stepper.pio).

.program ws2812
.side_set 1

.define public T1 3
.define public T2 3
.define public T3 4

.wrap_target
bitloop:
    out x, 1       side 0 [T3 - 1] ; low for the tail of the previous bit
    jmp !x do_zero side 1 [T1 - 1] ; high for every bit's head
do_one:
    jmp  bitloop   side 1 [T2 - 1] ; a 1 stays high
do_zero:
    nop            side 0 [T2 - 1] ; a 0 goes low
.wrap

% c-sdk {
#include "hardware/clocks.h"

static inline void ws2812_program_init(PIO pio, uint sm, uint offset, uint pin, float freq)
{
    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, true);
    pio_sm_config c = ws2812_program_get_default_config(offset);
    sm_config_set_sideset_pins(&c, pin);
    sm_config_set_out_shift(&c, false, true, 24);  // GRB, MSB first, autopull at 24 bits
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    const int cycles_per_bit = ws2812_T1 + ws2812_T2 + ws2812_T3;
    sm_config_set_clkdiv(&c, (float)clock_get_hz(clk_sys) / (freq * (float)cycles_per_bit));
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
