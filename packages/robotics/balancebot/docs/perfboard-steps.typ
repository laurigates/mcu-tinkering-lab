    "width=\"1122\" height=\"1034\"",
    "viewBox=\"" + str(x) + " " + str(y) + " " + str(w) + " " + str(h) + "\" width=\"" + str(w) + "\" height=\"" + str(h) + "\"")
  image(bytes(tag + group + body + "</g></svg>"), format: "svg", width: w * 0.3805mm)
}

